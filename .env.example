# ==============================================================================
# Responza Configuration Example
# Copy this file to '.env' and populate with your own credentials.
# NEVER commit your real '.env' file with production keys into version control.
# ==============================================================================

# Twilio Credentials (Get from Twilio Console: https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12000000000

# Emergency Contact Phone Number (The default recipient of SMS alerts)
ALERT_PHONE_NUMBER=+918499955374

# Flask Configuration
FLASK_DEBUG=False
FLASK_SECRET_KEY=change_me_to_a_random_secure_secret_key_in_production

# Database Configuration
DATABASE_PATH=responza.db
